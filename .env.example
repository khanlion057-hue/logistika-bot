# Bu fayl NAMUNA. O'zingizning .env faylingizni yarating (u GitHub'ga tushmaydi).
BOT_TOKEN=BotFather_bergan_token
ADMIN_IDS=123456789
ANTHROPIC_API_KEY=sk-ant-...
# Supabase -> Connect -> "Session pooler" manzili (parolni o'zingizniki bilan almashtiring)
DATABASE_URL=postgresql://postgres.PROJEKT_ID:PAROL@aws-0-REGION.pooler.supabase.com:5432/postgres
# Guruhlarda /id yozib ID larini oling (minus bilan boshlanadi)
COLLECT_CHAT_ID=-1001111111111
LOAD_CHAT_ID=-1002222222222
